# Copy to .env and replace the secret key for each installation.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
HIREATIONSHIP_DAILY_GENERATION_LIMIT=4
HIREATIONSHIP_DAILY_AI_LIMIT=20
HIREATIONSHIP_DAILY_JOB_SEARCH_LIMIT=30
# Optional: leave blank for local template-based profile parsing and writing.
HIREATIONSHIP_ALLOW_SHARED_CLAUDE=0
ANTHROPIC_API_KEY=
# Optional model override; otherwise the application default is used.
# ANTHROPIC_MODEL=
# Adzuna credentials enable live matching; Anthropic is optional.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
